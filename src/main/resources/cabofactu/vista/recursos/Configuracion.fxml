<?xml version="1.0" encoding="UTF-8"?>

<?import cabofactu.vista.utilidades.PreviaCabecera?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cabofactu.vista.controlador.ConfiguracionController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>
    <fx:define>
        <ToggleGroup fx:id="grupoCabecera"/>
        <ToggleGroup fx:id="grupoSecciones"/>
    </fx:define>
    <top>
        <VBox spacing="4">
            <fx:include fx:id="barra" source="BarraNavegacion.fxml"/>
            <Label styleClass="titulo" text="Configuración"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="12" styleClass="area-secciones">
            <VBox styleClass="lista-secciones" minWidth="200" prefWidth="200" maxWidth="200">
                <Label text="DATOS DE LA EMPRESA" styleClass="grupo-secciones" maxWidth="Infinity"/>
                <ToggleButton fx:id="btnDatosFiscales" text="Datos fiscales" toggleGroup="$grupoSecciones" onAction="#verDatosFiscales" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="btnLogotipo" text="Logotipo" toggleGroup="$grupoSecciones" onAction="#verLogotipo" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <Label text="FISCALIDAD" styleClass="grupo-secciones" maxWidth="Infinity"/>
                <ToggleButton fx:id="btnIva" text="Tipos de IVA" toggleGroup="$grupoSecciones" onAction="#verIva" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M7.5 11C9.43 11 11 9.43 11 7.5S9.43 4 7.5 4 4 5.57 4 7.5 5.57 11 7.5 11zm0-5C8.33 6 9 6.67 9 7.5S8.33 9 7.5 9 6 8.33 6 7.5 6.67 6 7.5 6zM4.0025 18.5832 18.5832 4.0025 19.9975 5.4168 5.4168 19.9975zM16.5 13c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5 3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="btnRetenciones" text="Retenciones IRPF" toggleGroup="$grupoSecciones" onAction="#verRetenciones" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="btnSeries" text="Series de numeración" toggleGroup="$grupoSecciones" onAction="#verSeries" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <Label text="FACTURA EN PDF" styleClass="grupo-secciones" maxWidth="Infinity"/>
                <ToggleButton fx:id="btnDisenoPdf" text="Diseño del PDF" toggleGroup="$grupoSecciones" onAction="#verDisenoPdf" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v1zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM9 9.5h1v-1H9v1zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm10 5.5h1v-3h-1v3z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <Label text="PREFERENCIAS" styleClass="grupo-secciones" maxWidth="Infinity"/>
                <ToggleButton fx:id="btnApariencia" text="Apariencia" toggleGroup="$grupoSecciones" onAction="#verApariencia" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="btnCarpetas" text="Carpetas" toggleGroup="$grupoSecciones" onAction="#verCarpetas" graphicTextGap="10">
                    <graphic>
                        <StackPane styleClass="caja-icono-seccion">
                            <SVGPath styleClass="icono-seccion" content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </VBox>
            <StackPane fx:id="pilaSecciones" HBox.hgrow="ALWAYS">
                <VBox fx:id="seccionDatosFiscales" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Datos fiscales"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="Nombre, NIF, domicilio y contacto que figurarán en cada factura emitida."/>
                    </VBox>
                    <Label fx:id="lblDatosPendientes" wrapText="true" visible="false" managed="false"
                           text="Completa los datos fiscales de tu empresa para empezar a facturar. Los campos con * son obligatorios."/>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="-Infinity"/>
                            <ColumnConstraints/>
                            <ColumnConstraints minWidth="-Infinity"/>
                            <ColumnConstraints/>
                        </columnConstraints>
                        <Label text="Nombre o razón social *"/>
                        <TextField fx:id="txtNombre" prefWidth="300" GridPane.columnIndex="1"/>
                        <Label text="NIF *" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtNif" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Actividad" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtActividad" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Domicilio fiscal *" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtDireccion" prefWidth="400" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                        <Label text="Código postal *" GridPane.rowIndex="3"/>
                        <TextField fx:id="txtCp" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Localidad *" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <TextField fx:id="txtLocalidad" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                        <Label text="Provincia *" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtProvincia" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Correo electrónico *" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtEmail" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                        <Label text="Teléfono *" GridPane.rowIndex="5"/>
                        <TextField fx:id="txtTelefono" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    </GridPane>
                </VBox>
                <VBox fx:id="seccionLogotipo" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Logotipo"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="La imagen de tu empresa en el menú principal, el editor y la cabecera del PDF."/>
                    </VBox>
                    <HBox spacing="14">
                        <GridPane hgap="8" vgap="6" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints minWidth="-Infinity"/>
                                <ColumnConstraints/>
                            </columnConstraints>
                            <Label text="Imagen del logotipo"/>
                            <TextField fx:id="txtLogoPath" editable="false" prefWidth="300" GridPane.columnIndex="1"/>
                            <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Button onAction="#seleccionarLogo" styleClass="default-button, btn-suave" text="Elegir imagen…"/>
                                <Button onAction="#quitarLogotipo" styleClass="default-button, btn-suave" text="Quitar logotipo"/>
                            </HBox>
                        </GridPane>
                        <StackPane fx:id="logoPrevia" styleClass="menu-logo-box" prefWidth="280.0" prefHeight="100.0" maxWidth="280.0" maxHeight="100.0" minWidth="280.0" minHeight="100.0">
                            <ImageView fx:id="imgLogoPrevia" preserveRatio="true"/>
                        </StackPane>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionIva" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M7.5 11C9.43 11 11 9.43 11 7.5S9.43 4 7.5 4 4 5.57 4 7.5 5.57 11 7.5 11zm0-5C8.33 6 9 6.67 9 7.5S8.33 9 7.5 9 6 8.33 6 7.5 6.67 6 7.5 6zM4.0025 18.5832 18.5832 4.0025 19.9975 5.4168 5.4168 19.9975zM16.5 13c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5 3.5-1.57 3.5-3.5-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Tipos de IVA"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="Tipos impositivos disponibles al facturar, incluidos los exentos y los suplidos."/>
                    </VBox>
                    <TableView fx:id="tablaIva" prefHeight="120" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarIva">
                        <columns>
                            <TableColumn fx:id="colIvaNombre" prefWidth="180" text="Nombre"/>
                            <TableColumn fx:id="colIvaPorcentaje" prefWidth="90" text="Porcentaje"/>
                            <TableColumn fx:id="colIvaSuplido" prefWidth="70" text="Suplido"/>
                            <TableColumn fx:id="colIvaMotivo" prefWidth="240" text="Motivo de exención"/>
                            <TableColumn fx:id="colIvaActivo" prefWidth="80" text="Activo"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button onAction="#nuevoIva" styleClass="default-button, btn-suave" text="Nuevo"/>
                        <Button onAction="#editarIva" styleClass="default-button, btn-suave" text="Editar"/>
                        <Button onAction="#eliminarIva" styleClass="default-button, btn-suave" text="Eliminar"/>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionRetenciones" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Retenciones IRPF"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="Porcentajes de retención para profesionales y actividades sujetas a IRPF."/>
                    </VBox>
                    <TableView fx:id="tablaRetenciones" prefHeight="120" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarRetencion">
                        <columns>
                            <TableColumn fx:id="colRetencionNombre" prefWidth="280" text="Nombre"/>
                            <TableColumn fx:id="colRetencionPorcentaje" prefWidth="110" text="Porcentaje"/>
                            <TableColumn fx:id="colRetencionActivo" prefWidth="80" text="Activo"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button onAction="#nuevoRetencion" styleClass="default-button, btn-suave" text="Nuevo"/>
                        <Button onAction="#editarRetencion" styleClass="default-button, btn-suave" text="Editar"/>
                        <Button onAction="#eliminarRetencion" styleClass="default-button, btn-suave" text="Eliminar"/>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionSeries" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Series de numeración"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="Las series con las que numeras tus facturas: ordinarias, rectificativas y otras."/>
                    </VBox>
                    <TableView fx:id="tablaSeries" prefHeight="120" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarSerie">
                        <columns>
                            <TableColumn fx:id="colSerieCodigo" prefWidth="80" text="Código"/>
                            <TableColumn fx:id="colSerieDescripcion" prefWidth="200" text="Descripción"/>
                            <TableColumn fx:id="colSerieRectifica" prefWidth="110" text="Rectificativa"/>
                            <TableColumn fx:id="colSerieFormato" prefWidth="200" text="Formato"/>
                            <TableColumn fx:id="colSerieSiguiente" prefWidth="120" text="Siguiente"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button onAction="#nuevaSerie" styleClass="default-button, btn-suave" text="Nuevo"/>
                        <Button onAction="#editarSerie" styleClass="default-button, btn-suave" text="Editar"/>
                        <Button onAction="#eliminarSerie" styleClass="default-button, btn-suave" text="Eliminar"/>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionDisenoPdf" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v1zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM9 9.5h1v-1H9v1zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm10 5.5h1v-3h-1v3z"/>
                            </StackPane>
                            <Label styleClass="titulo-seccion" text="Diseño del PDF"/>
                        </HBox>
                        <Label styleClass="ayuda-seccion, muted" wrapText="true"
                               text="Personaliza la cabecera, el pie legal y el color de tus facturas en PDF."/>
                    </VBox>
                    <HBox spacing="14">
                        <GridPane hgap="8" vgap="6" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints minWidth="-Infinity"/>
                                <ColumnConstraints/>
                            </columnConstraints>
                            <Label text="Cabecera"/>
                            <VBox spacing="4" GridPane.columnIndex="1">
                                <RadioButton fx:id="rbTexto" toggleGroup="$grupoCabecera" text="Datos de la empresa en texto"/>
                                <RadioButton fx:id="rbLogo" toggleGroup="$grupoCabecera" text="Logotipo"/>
                            </VBox>
                            <Label text="Pie legal" GridPane.rowIndex="1"/>
                            <TextArea fx:id="txtPieLegal" prefRowCount="3" wrapText="true"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Color de acento" GridPane.rowIndex="2"/>
                            <ColorPicker fx:id="colorPdf" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Label styleClass="muted"
                                   text="Se usa en las cabeceras de las tarjetas, los totales, el pie legal, el número y la fecha."
                                   wrapText="true" GridPane.columnSpan="2" GridPane.rowIndex="3"/>
                        </GridPane>
                        <VBox spacing="6" alignment="TOP_LEFT">
                            <PreviaCabecera fx:id="previaCabecera" styleClass="previa-cabecera"/>
                            <Label styleClass="muted, vista-aviso" text="Vista previa de la cabecera"/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionApariencia" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <VBox styleClass="cabecera-seccion">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <StackPane styleClass="caja-icono-seccion">
                                <SVGPath styleClass="icono-seccion" content="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
