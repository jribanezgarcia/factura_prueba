<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="620.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.EditorController">
    <top>
        <VBox>
            <ToolBar>
                <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar"/>
                <Button fx:id="btnExportar" onAction="#exportarPdf" text="Exportar PDF"/>
                <Button fx:id="btnVersiones" onAction="#verVersiones" text="Versiones"/>
                <Button fx:id="btnRectificativa" onAction="#crearRectificativa" text="Crear rectificativa"/>
                <Button fx:id="btnAnular" onAction="#anular" text="Anular"/>
                <Button fx:id="btnRestaurar" onAction="#restaurar" text="Restaurar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#nuevaFactura" text="Nueva factura"/>
                <Button onAction="#volver" text="Volver"/>
            </ToolBar>
            <Label fx:id="lblTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 8 12 4 12;" text="Nueva factura"/>
            <Label fx:id="lblEstado" visible="false" managed="false" text="ANULADA"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b00020; -fx-padding: 0 12 4 12;"/>
            <GridPane fx:id="cabecera" hgap="8" vgap="6" style="-fx-padding: 4 12 8 12;">
                <Label text="Serie"/>
                <ComboBox fx:id="comboSerie" prefWidth="120" GridPane.columnIndex="1"/>
                <Label text="Fecha" GridPane.columnIndex="2"/>
                <DatePicker fx:id="fecha" prefWidth="140" GridPane.columnIndex="3"/>
                <Label text="Número" GridPane.columnIndex="4"/>
                <TextField fx:id="txtNumero" prefWidth="140" GridPane.columnIndex="5"/>
                <Label text="Cliente" GridPane.rowIndex="1"/>
                <ComboBox fx:id="comboCliente" editable="true" prefWidth="420" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="1"/>
                <Label text="Nombre" GridPane.rowIndex="2"/>
                <TextField fx:id="cliNombre" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="NIF" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="cliNif" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <Label text="Dirección" GridPane.rowIndex="3"/>
                <TextField fx:id="cliDireccion" prefWidth="440" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="3"/>
                <Label text="CP" GridPane.rowIndex="4"/>
                <TextField fx:id="cliCp" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Localidad" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <TextField fx:id="cliLocalidad" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                <Label text="Provincia" GridPane.columnIndex="4" GridPane.rowIndex="4"/>
                <TextField fx:id="cliProvincia" prefWidth="150" GridPane.columnIndex="5" GridPane.rowIndex="4"/>
                <Label fx:id="lblReferencia" text="Referencia rectifica" GridPane.rowIndex="5"/>
                <TextField fx:id="txtReferencia" prefWidth="300" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="5"/>
            </GridPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="6" style="-fx-padding: 4 12 8 12;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnAnadirLinea" onAction="#anadirLinea" text="Añadir línea"/>
                <Button fx:id="btnEliminarLinea" onAction="#eliminarLinea" text="Eliminar línea (Supr)"/>
                <CheckBox fx:id="chkTotalConIva" text="Total de línea con IVA incluido"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Descuento"/>
                <TextField fx:id="txtDescuento" prefWidth="60" promptText="0"/>
                <Label text="\%"/>
            </HBox>
            <TableView fx:id="tablaLineas" editable="true">
                <columns>
                    <TableColumn fx:id="colCantidad" prefWidth="70" text="Cant."/>
                    <TableColumn fx:id="colDescripcion" prefWidth="360" text="Descripción"/>
                    <TableColumn fx:id="colPrecio" prefWidth="110" text="Precio"/>
                    <TableColumn fx:id="colTotal" prefWidth="120" text="Total"/>
                    <TableColumn fx:id="colIva" prefWidth="140" text="IVA"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <VBox spacing="6" style="-fx-padding: 4 12 10 12;">
            <HBox spacing="16" alignment="TOP_LEFT">
                <VBox spacing="4">
                    <Label text="Resumen" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblResumen" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="360">
                    <Label text="Observaciones"/>
                    <TextArea fx:id="txtObservaciones" prefRowCount="4" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
