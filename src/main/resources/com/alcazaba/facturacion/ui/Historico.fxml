<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.HistoricoController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>
    <top>
        <VBox spacing="12">
            <HBox fx:id="barraNavegacion" styleClass="nav-bar"/>
            <VBox spacing="8" styleClass="card, zona-contenido, panel-busqueda">
                <GridPane styleClass="grid-filtros" maxWidth="-Infinity">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="-Infinity"/>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints hgrow="NEVER" minWidth="-Infinity"/>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints hgrow="NEVER" minWidth="-Infinity"/>
                        <ColumnConstraints hgrow="NEVER"/>
                        <ColumnConstraints hgrow="NEVER" minWidth="-Infinity"/>
                        <ColumnConstraints hgrow="NEVER"/>
                    </columnConstraints>
                    <Label text="Serie"/>
                    <ComboBox fx:id="comboSerie" prefWidth="120" GridPane.columnIndex="1"/>
                    <Label text="Cliente/NIF" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtCliente" prefWidth="200" promptText="Nombre o NIF" GridPane.columnIndex="3"/>
                    <Label text="Desde" GridPane.columnIndex="4"/>
                    <DatePicker fx:id="fechaDesde" GridPane.columnIndex="5"/>
                    <Label text="Hasta" GridPane.columnIndex="6"/>
                    <DatePicker fx:id="fechaHasta" GridPane.columnIndex="7"/>
                    <Label text="Importe desde" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtImporteDesde" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Hasta" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtImporteHasta" prefWidth="100" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <Label text="Estado" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="comboEstado" prefWidth="120" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                </GridPane>
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button onAction="#buscar" styleClass="primary-button, btn-ribbon" text="Buscar">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </graphic>
                    </Button>
                    <Button onAction="#generarMensual" styleClass="default-button, btn-ribbon" text="Generar mensuales">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/>
                        </graphic>
                    </Button>
                    <Separator orientation="VERTICAL" styleClass="ribbon-sep"/>
                    <Button fx:id="btnExportarPdf" onAction="#exportarPdf" styleClass="default-button, btn-ribbon" text="Exportar PDF">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8.5 7.5c0 .83-.67 1.5-1.5 1.5H9v2H7.5V7H10c.83 0 1.5.67 1.5 1.5v1zm5 2c0 .83-.67 1.5-1.5 1.5h-2.5V7H15c.83 0 1.5.67 1.5 1.5v3zm4-3H19v1h1.5V11H19v2h-1.5V7h3v1.5zM9 9.5h1v-1H9v1zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm10 5.5h1v-3h-1v3z"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnAnular" onAction="#anularSeleccionadas" styleClass="default-button, btn-ribbon" text="Anular">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnBorrar" onAction="#borrarSeleccionadas" styleClass="default-button, btn-ribbon" text="Eliminar">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </graphic>
                    </Button>
                    <Separator orientation="VERTICAL" styleClass="ribbon-sep"/>
                    <Button onAction="#volver" styleClass="default-button, btn-ribbon" text="Volver">
                        <graphic>
                            <SVGPath styleClass="icono-boton" content="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla" styleClass="card">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="90" text="Fecha"/>
                <TableColumn fx:id="colNumero" prefWidth="110" text="Número"/>
                <TableColumn fx:id="colVersion" prefWidth="70" text="Versión"/>
                <TableColumn fx:id="colCliente" prefWidth="220" text="Cliente"/>
                <TableColumn fx:id="colNif" prefWidth="120" text="NIF"/>
                <TableColumn fx:id="colBase" prefWidth="100" text="Base imponible"/>
                <TableColumn fx:id="colIva" prefWidth="100" text="IVA"/>
                <TableColumn fx:id="colRetencion" prefWidth="100" text="Retención"/>
                <TableColumn fx:id="colTotal" prefWidth="110" text="Total"/>
                <TableColumn fx:id="colEstado" prefWidth="90" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>