<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.HistoricoController">
    <top>
        <VBox>
            <HBox fx:id="barraNavegacion" styleClass="nav-bar"/>
            <VBox spacing="8" styleClass="zona-contenido">
                <FlowPane hgap="10" vgap="8">
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Serie"/>
                        <ComboBox fx:id="comboSerie" prefWidth="120"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Cliente/NIF"/>
                        <TextField fx:id="txtCliente" prefWidth="200" promptText="Nombre o NIF"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Desde"/>
                        <DatePicker fx:id="fechaDesde"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Hasta"/>
                        <DatePicker fx:id="fechaHasta"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Importe desde"/>
                        <TextField fx:id="txtImporteDesde" prefWidth="100"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Hasta"/>
                        <TextField fx:id="txtImporteHasta" prefWidth="100"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Estado"/>
                        <ComboBox fx:id="comboEstado" prefWidth="120"/>
                    </HBox>
                </FlowPane>
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button fx:id="btnExportarPdf" onAction="#exportarPdf" styleClass="default-button" text="Exportar PDF"/>
                    <Button onAction="#buscar" styleClass="primary-button" text="Buscar"/>
                    <Button onAction="#volver" styleClass="default-button" text="Volver"/>
                </HBox>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="90" text="Fecha"/>
                <TableColumn fx:id="colNumero" prefWidth="110" text="Número"/>
                <TableColumn fx:id="colVersion" prefWidth="70" text="Versión"/>
                <TableColumn fx:id="colCliente" prefWidth="220" text="Cliente"/>
                <TableColumn fx:id="colNif" prefWidth="120" text="NIF"/>
                <TableColumn fx:id="colBase" prefWidth="100" text="Base"/>
                <TableColumn fx:id="colIva" prefWidth="100" text="IVA"/>
                <TableColumn fx:id="colTotal" prefWidth="110" text="Total"/>
                <TableColumn fx:id="colEstado" prefWidth="90" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>