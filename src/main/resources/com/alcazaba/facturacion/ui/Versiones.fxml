<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="500.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.VersionesController">
    <top>
        <VBox>
            <HBox fx:id="barraNavegacion" styleClass="nav-bar"/>
            <VBox spacing="8" styleClass="card zona-contenido">
                <Label fx:id="lblTitulo" styleClass="titulo" text="Versiones de la factura"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Doble clic en una versión para abrirla." styleClass="muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#volver" styleClass="default-button" text="Volver"/>
                </HBox>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla" styleClass="card">
            <columns>
                <TableColumn fx:id="colVersion" prefWidth="90" text="Versión"/>
                <TableColumn fx:id="colFecha" prefWidth="120" text="Fecha factura"/>
                <TableColumn fx:id="colGuardado" prefWidth="160" text="Guardado"/>
                <TableColumn fx:id="colEstado" prefWidth="110" text="Estado"/>
                <TableColumn fx:id="colTotal" prefWidth="140" text="Total"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>