<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<BorderPane prefHeight="520.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.MenuController">
    <top>
        <VBox alignment="CENTER" spacing="8" styleClass="zona-contenido">
            <HBox alignment="CENTER" spacing="8">
                <Label text="Fecha de trabajo:"/>
                <Label fx:id="fechaTrabajo" styleClass="muted"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane styleClass="zona-contenido">
            <HBox alignment="TOP_LEFT" spacing="24" maxWidth="-Infinity" maxHeight="-Infinity">
            <VBox alignment="TOP_LEFT" spacing="12" styleClass="card">
                <StackPane styleClass="menu-logo-box" prefWidth="260.0" prefHeight="120.0" minWidth="240.0" minHeight="110.0">
                    <ImageView fx:id="logo" preserveRatio="true"/>
                </StackPane>
                <Label fx:id="lblEmpresa" styleClass="empresa-nombre" text=""/>
                <Label fx:id="lblEmpresaInfo" styleClass="empresa-info" text=""/>
            </VBox>
            <VBox spacing="4" prefWidth="430.0" maxWidth="430.0" styleClass="card">
                <Button maxWidth="Infinity" onAction="#nuevaFactura" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Nueva factura"/>
                                <Label styleClass="descripcion" text="Crear o editar una factura de la serie activa"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#generarMensual" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Generar facturas mensuales"/>
                                <Label styleClass="descripcion" text="Crear varias facturas de un cliente a la vez"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#historico" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Histórico"/>
                                <Label styleClass="descripcion" text="Consultar y buscar todas las facturas"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#clientes" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Clientes"/>
                                <Label styleClass="descripcion" text="Gestionar el catálogo de clientes"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#configuracion" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.05-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Configuración"/>
                                <Label styleClass="descripcion" text="Datos de empresa, cabecera, IVA y series"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#backup" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Copia de seguridad"/>
                                <Label styleClass="descripcion" text="Fotografía completa de la base de datos"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
                <Button maxWidth="Infinity" onAction="#salir" styleClass="menu-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <SVGPath styleClass="icono" content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                            <VBox alignment="CENTER_LEFT" spacing="2">
                                <Label styleClass="nombre" text="Salir"/>
                                <Label styleClass="descripcion" text="Cierra la aplicación"/>
                            </VBox>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>
            </HBox>
        </StackPane>
    </center>
</BorderPane>