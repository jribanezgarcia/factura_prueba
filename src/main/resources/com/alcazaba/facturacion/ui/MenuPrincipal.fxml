<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="520.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.MenuController">
    <top>
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 24 0 8 0;">
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Facturación"/>
            <HBox alignment="CENTER" spacing="8">
                <Label text="Fecha de trabajo:"/>
                <DatePicker fx:id="fechaTrabajo" promptText="dd/mm/aaaa"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 12;">
            <Button maxWidth="280.0" minWidth="280.0" onAction="#nuevaFactura" prefHeight="34.0" text="Nueva factura"/>
            <Button maxWidth="280.0" minWidth="280.0" onAction="#historico" prefHeight="34.0" text="Histórico"/>
            <Button maxWidth="280.0" minWidth="280.0" onAction="#clientes" prefHeight="34.0" text="Clientes"/>
            <Button maxWidth="280.0" minWidth="280.0" onAction="#configuracion" prefHeight="34.0" text="Configuración"/>
            <Button maxWidth="280.0" minWidth="280.0" onAction="#backup" prefHeight="34.0" text="Copia de seguridad"/>
            <Button maxWidth="280.0" minWidth="280.0" onAction="#salir" prefHeight="34.0" text="Salir"/>
        </VBox>
    </center>
</BorderPane>
