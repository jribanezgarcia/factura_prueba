<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="450.0" prefWidth="720.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.BackupController">
    <top>
        <VBox spacing="8" style="-fx-padding: 12;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Copia de seguridad"/>
            <Label text="La copia guarda una fotografía completa de la base de datos (facturas_AAAAMMDD_HHMMSS.db)."/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button onAction="#seleccionarDestino" text="Seleccionar carpeta de destino..."/>
                <Label fx:id="lblDestino" text="(ninguna carpeta seleccionada)" style="-fx-text-fill: #666666;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8" style="-fx-padding: 12;" alignment="TOP_CENTER">
            <Button fx:id="btnCrear" disable="true" onAction="#crear" text="Crear copia de seguridad"/>
            <Label fx:id="lblResultado" wrapText="true"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 12;">
            <Button onAction="#volver" text="Volver"/>
        </HBox>
    </bottom>
</BorderPane>
