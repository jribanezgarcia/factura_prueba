<?xml version="1.0" encoding="UTF-8"?>

<?import com.alcazaba.facturacion.ui.PreviaCabecera?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.ConfiguracionController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>
    <fx:define>
        <ToggleGroup fx:id="grupoCabecera"/>
    </fx:define>
    <top>
        <VBox spacing="4">
            <HBox fx:id="barraNavegacion" styleClass="nav-bar"/>
            <Label styleClass="titulo" text="Configuración"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="12" styleClass="area-secciones">
            <ListView fx:id="listaSecciones" minWidth="200" prefWidth="200" maxWidth="200"
                      styleClass="lista-secciones"/>
            <StackPane fx:id="pilaSecciones" HBox.hgrow="ALWAYS">
                <VBox fx:id="seccionEmpresa" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <GridPane hgap="8" vgap="6">
                        <Label text="Nombre / razón social"/>
                        <TextField fx:id="txtNombre" prefWidth="300" GridPane.columnIndex="1"/>
                        <Label text="NIF" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtNif" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Actividad" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtActividad" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Dirección" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtDireccion" prefWidth="400" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                        <Label text="CP" GridPane.rowIndex="3"/>
                        <TextField fx:id="txtCp" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Localidad" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <TextField fx:id="txtLocalidad" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                        <Label text="Provincia" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtProvincia" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Email" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtEmail" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                        <Label text="Teléfono" GridPane.rowIndex="5"/>
                        <TextField fx:id="txtTelefono" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    </GridPane>
                </VBox>
                <VBox fx:id="seccionCabeceraPie" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <HBox spacing="14">
                        <GridPane hgap="8" vgap="6" HBox.hgrow="ALWAYS">
                            <Label text="Modo de cabecera"/>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.columnSpan="3">
                                <RadioButton fx:id="rbTexto" toggleGroup="$grupoCabecera" text="Texto con datos de empresa"/>
                                <RadioButton fx:id="rbLogo" toggleGroup="$grupoCabecera" text="Logo / imagen"/>
                            </VBox>
                            <Label text="Logo" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtLogoPath" editable="false" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Button onAction="#seleccionarLogo" styleClass="default-button" text="Elegir imagen..." GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <Label text="Texto legal del pie" GridPane.rowIndex="2"/>
                            <TextArea fx:id="txtPieLegal" prefRowCount="3" wrapText="true"
                                      GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                        </GridPane>
                        <VBox spacing="6" alignment="TOP_LEFT">
                            <PreviaCabecera fx:id="previaCabecera" styleClass="previa-cabecera"/>
                            <Label styleClass="muted, vista-aviso"
                                   text="Vista aproximada de la cabecera del PDF."/>
                        </VBox>
                    </HBox>
                </VBox>
                <VBox fx:id="seccionPdfApariencia" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <GridPane hgap="8" vgap="6">
                        <Label text="Carpeta automática de almacenamiento"/>
                        <TextField fx:id="txtCarpetaAuto" editable="false" prefWidth="420" GridPane.columnIndex="1"/>
                        <Button onAction="#seleccionarCarpetaAuto" styleClass="default-button" text="Elegir carpeta..." GridPane.columnIndex="2"/>
                        <Label text="Última carpeta de exportación" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtUltimaCarpeta" editable="false" prefWidth="420" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Color del PDF" GridPane.rowIndex="2"/>
                        <ColorPicker fx:id="colorPdf" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label styleClass="muted" text="Color de acento: cabeceras de tarjetas, totales y pie legal; también SERIE/Nº y FECHA"
                               GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <Label text="Tema de la aplicación" GridPane.rowIndex="3"/>
                        <ComboBox fx:id="comboTema" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>
                <VBox fx:id="seccionIva" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <TableView fx:id="tablaIva" prefHeight="120" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colIvaNombre" prefWidth="180" text="Nombre"/>
                            <TableColumn fx:id="colIvaPorcentaje" prefWidth="90" text="Tipo"/>
                            <TableColumn fx:id="colIvaMotivo" prefWidth="240" text="Motivo exención"/>
                            <TableColumn fx:id="colIvaActivo" prefWidth="80" text="Activo"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <FlowPane hgap="10" vgap="8" styleClass="alta-rapida">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Nombre"/>
                            <TextField fx:id="txtIvaNombre" prefWidth="160"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Tipo (vacío = exento)"/>
                            <TextField fx:id="txtIvaPorcentaje" prefWidth="80" promptText="21"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Motivo"/>
                            <TextField fx:id="txtIvaMotivo" prefWidth="200"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button onAction="#nuevoIva" styleClass="default-button" text="Nuevo"/>
                            <Button onAction="#guardarIva" styleClass="primary-button" text="Guardar"/>
                            <Button onAction="#inactivarIva" styleClass="default-button" text="Inactivar/Activar"/>
                        </HBox>
                    </FlowPane>
                    <Label fx:id="lblIvaAviso" styleClass="muted"
                           text="El porcentaje de un tipo ya usado en el histórico no se puede modificar."/>
                </VBox>
                <VBox fx:id="seccionRetenciones" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <TableView fx:id="tablaRetenciones" prefHeight="120" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRetencionNombre" prefWidth="280" text="Nombre"/>
                            <TableColumn fx:id="colRetencionPorcentaje" prefWidth="110" text="Porcentaje"/>
                            <TableColumn fx:id="colRetencionActivo" prefWidth="80" text="Activo"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <FlowPane hgap="10" vgap="8" styleClass="alta-rapida">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Nombre"/>
                            <TextField fx:id="txtRetencionNombre" prefWidth="180"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Porcentaje"/>
                            <TextField fx:id="txtRetencionPorcentaje" prefWidth="80" promptText="19"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button onAction="#nuevoRetencion" styleClass="default-button" text="Nuevo"/>
                            <Button onAction="#guardarRetencion" styleClass="primary-button" text="Guardar"/>
                            <Button onAction="#inactivarRetencion" styleClass="default-button" text="Inactivar/Activar"/>
                        </HBox>
                    </FlowPane>
                    <Label fx:id="lblRetencionAviso" styleClass="muted"
                           text="El porcentaje de un tipo ya usado en el histórico no se puede modificar."/>
                </VBox>
                <VBox fx:id="seccionSeries" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <TableView fx:id="tablaSeries" prefHeight="120" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSerieCodigo" prefWidth="80" text="Código"/>
                            <TableColumn fx:id="colSerieDescripcion" prefWidth="200" text="Descripción"/>
                            <TableColumn fx:id="colSerieRectifica" prefWidth="110" text="Rectificativa"/>
                            <TableColumn fx:id="colSerieSiguiente" prefWidth="100" text="Siguiente"/>
                            <TableColumn fx:id="colSerieReutilizar" prefWidth="110" text="Reutilizar anulados"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <FlowPane hgap="10" vgap="8" styleClass="alta-rapida">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Código"/>
                            <TextField fx:id="txtSerieCodigo" prefWidth="80"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Descripción"/>
                            <TextField fx:id="txtSerieDescripcion" prefWidth="200"/>
                        </HBox>
                        <CheckBox fx:id="chkSerieRectifica" text="Rectificativa"/>
                        <CheckBox fx:id="chkSerieReutilizar" text="Reutilizar anulados"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Siguiente número"/>
                            <TextField fx:id="txtSerieSiguiente" prefWidth="80"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Formato"/>
                            <ComboBox fx:id="comboSerieFormato" prefWidth="200"/>
                        </HBox>
                        <Label fx:id="lblSerieEjemplo" styleClass="muted" text="Ejemplo: C-56/7"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Button onAction="#nuevoSerie" styleClass="default-button" text="Nuevo"/>
                            <Button onAction="#guardarSerie" styleClass="primary-button" text="Guardar"/>
                            <Button onAction="#eliminarSerie" styleClass="default-button" text="Eliminar"/>
                        </HBox>
                    </FlowPane>
                </VBox>
                <VBox fx:id="seccionEmpresas" visible="false" managed="false" spacing="8"
                      styleClass="card, zona-contenido, seccion-config">
                    <TableView fx:id="tablaEmpresas" prefHeight="120" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEmpresaNombre" prefWidth="240" text="Nombre"/>
                            <TableColumn fx:id="colEmpresaSlug" prefWidth="200" text="Carpeta de datos"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblEmpresasAviso" styleClass="muted"
                           text="Al eliminar una empresa se borra físicamente su carpeta de datos. Realiza antes una copia de seguridad."/>
                    <FlowPane hgap="8" vgap="8" styleClass="alta-rapida">
                        <Button onAction="#nuevaEmpresa" styleClass="default-button" text="Nueva empresa"/>
                        <Button onAction="#cambiarEmpresa" styleClass="primary-button" text="Cambiar a esta"/>
                        <Button onAction="#eliminarEmpresa" styleClass="default-button" text="Eliminar"/>
                    </FlowPane>
                </VBox>
            </StackPane>
        </HBox>
    </center>
    <bottom>
        <HBox fx:id="barraGuardar" spacing="8" alignment="CENTER_RIGHT" styleClass="card, zona-contenido">
            <Button onAction="#guardar" styleClass="primary-button" text="Guardar configuración"/>
            <Button onAction="#volver" styleClass="default-button" text="Volver"/>
        </HBox>
    </bottom>
</BorderPane>