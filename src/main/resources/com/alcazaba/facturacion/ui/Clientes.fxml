<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.ClientesController">
    <top>
        <VBox>
            <HBox fx:id="barraNavegacion" styleClass="nav-bar"/>
            <VBox spacing="8" styleClass="card zona-contenido">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBusqueda" prefWidth="280" promptText="Buscar por nombre o NIF..."/>
                    <Label fx:id="lblConteo" text=""/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#nuevo" styleClass="primary-button" text="Nuevo"/>
                    <Button onAction="#editar" styleClass="default-button" text="Editar"/>
                    <Button onAction="#eliminar" styleClass="danger-button" text="Eliminar"/>
                    <Button onAction="#volver" styleClass="default-button" text="Volver"/>
                </HBox>
            </VBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla" styleClass="card">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre"/>
                <TableColumn fx:id="colNif" prefWidth="130" text="NIF"/>
                <TableColumn fx:id="colLocalidad" prefWidth="180" text="Localidad"/>
                <TableColumn fx:id="colEstado" prefWidth="100" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>