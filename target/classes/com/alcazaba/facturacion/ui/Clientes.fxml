<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alcazaba.facturacion.ui.ClientesController">
    <top>
        <VBox spacing="8" style="-fx-padding: 12;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txtBusqueda" prefWidth="280" promptText="Buscar por nombre o NIF..."/>
                <Label fx:id="lblConteo" text=""/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#nuevo" text="Nuevo"/>
                <Button onAction="#editar" text="Editar"/>
                <Button onAction="#eliminar" text="Eliminar"/>
                <Button onAction="#volver" text="Volver"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre"/>
                <TableColumn fx:id="colNif" prefWidth="130" text="NIF"/>
                <TableColumn fx:id="colLocalidad" prefWidth="180" text="Localidad"/>
                <TableColumn fx:id="colEstado" prefWidth="100" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
